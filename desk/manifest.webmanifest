{
  "name": "TheDesk",
  "short_name": "TheDesk",
  "description": "Three picks locked every morning, opened 30 minutes before each game and graded at the final.",
  "id": "/desk/",
  "start_url": "./?source=app",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#06190F",
  "theme_color": "#0E3B2C",
  "categories": [
    "sports",
    "entertainment"
  ],
  "icons": [
    {
      "src": "../brand/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "../brand/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "../brand/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Today's card",
      "url": "./#today",
      "icons": [
        {
          "src": "../brand/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "The sheet",
      "url": "./#slate",
      "icons": [
        {
          "src": "../brand/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "LongShots",
      "url": "./#longshots",
      "icons": [
        {
          "src": "../brand/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "My tickets",
      "url": "./#tix",
      "icons": [
        {
          "src": "../brand/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Every result",
      "url": "./#receipts",
      "icons": [
        {
          "src": "../brand/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "widgets": [
    {
      "name": "TheDesk · Today",
      "short_name": "Today",
      "description": "Today's Best 3, sealed, open, live and graded, through your My Desk filters.",
      "tag": "today",
      "ms_ac_template": "widget/today.json",
      "data": "widget/today-data.json",
      "type": "application/json",
      "screenshots": [
        {
          "src": "img/widget-today.png",
          "sizes": "600x400",
          "label": "Today's Best 3 on the Windows Widgets Board"
        }
      ],
      "icons": [
        {
          "src": "../brand/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "auth": false,
      "update": 900
    }
  ]
}
