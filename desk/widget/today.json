{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "${title}", "weight": "Bolder", "size": "Large", "color": "Accent", "wrap": true },
    { "type": "Container", "$data": "${rows}", "spacing": "Small", "items": [
      { "type": "ColumnSet", "columns": [
        { "type": "Column", "width": "auto", "items": [ { "type": "TextBlock", "text": "${n}", "weight": "Bolder", "isSubtle": true } ] },
        { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${line}", "weight": "Bolder", "wrap": true }, { "type": "TextBlock", "text": "${sub}", "isSubtle": true, "size": "Small", "spacing": "None", "wrap": true } ] },
        { "type": "Column", "width": "auto", "items": [ { "type": "TextBlock", "text": "${tag}", "weight": "Bolder", "color": "${color}" } ] }
      ] }
    ] },
    { "type": "TextBlock", "text": "${rec}", "isSubtle": true, "size": "Small", "spacing": "Medium", "wrap": true }
  ],
  "actions": [ { "type": "Action.OpenUrl", "title": "Open TheDesk", "url": "https://ironsilkweekly.com/desk/#today" } ]
}
